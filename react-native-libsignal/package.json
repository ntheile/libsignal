{
  "name": "react-native-libsignal",
  "version": "0.1.0",
  "description": "React Native bindings for the Signal Protocol using uniffi-bindgen-react-native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "ReactNativeLibsignalFramework.xcframework",
    "react-native.config.js",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!**/*.log",
    "!**/.DS_Store",
    "!rust_modules",
    "!example",
    "!node_modules",
    "!yarn.lock",
    "!package.tgz"
  ],
  "scripts": {
    "start": "yarn example start",
    "ubrn:ios": "ubrn build ios --config ubrn.config.yaml --release --and-generate && (cd example/ios && pod install)",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --release --and-generate",
    "ubrn:checkout": "ubrn checkout --config ubrn.config.yaml",
    "ubrn:clean": "rm -Rf cpp/ android/src/main/java ios/ src/Native* src/generated/ src/index.ts*",
    "example": "yarn workspace react-native-libsignal-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib && yarn cache clean --all",
    "build": "bob build --target commonjs && bob build --target module && (bob build --target typescript || echo 'TypeScript build failed but definitions may still be generated') && cp src/generated/* lib/typescript/commonjs/src/generated/ 2>/dev/null || true && cp src/generated/* lib/typescript/commonjs/src/ 2>/dev/null || true",
    "prepare": "yarn build",
    "release": "release-it",
    "package": "yarn prepare && yarn pack"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "signal",
    "signal-protocol",
    "encryption",
    "e2e",
    "libsignal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalapp/libsignal.git"
  },
  "author": "Signal Messenger LLC",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/signalapp/libsignal/issues"
  },
  "homepage": "https://github.com/signalapp/libsignal#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native/eslint-config": "^0.78.0",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.0.0",
    "del-cli": "^5.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.0.0",
    "react-native": "0.78.1",
    "react-native-builder-bob": "^0.39.0",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": {
            "skipLibCheck": true,
            "skipDefaultLibCheck": true,
            "noErrorTruncation": false,
            "noEmitOnError": false,
            "ignoreDeprecations": true,
            "isolatedModules": false
          }
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNReactNativeLibsignalSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.reactnativelibsignal"
    },
    "includesGeneratedCode": true
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "version": "0.49.0"
  },
  "dependencies": {
    "uniffi-bindgen-react-native": "0.29.0-0"
  }
}
